# 复制为 .env.local 后按需修改（.env.local 已被 git 忽略）

# 运行模式：mock（默认，纯前端模拟）| remote（真实接口）
VITE_SERVICE_MODE=mock

# 浏览器访问的网关地址。开发时保持 /api，由 Vite 代理转发到 VITE_PROXY_TARGET
VITE_API_BASE=/api

# 默认模型 ID（也可在“数据与接口”页面中设置）
VITE_DEFAULT_MODEL=

# ---- 以下仅作用于开发代理（Node 侧），不会打包进前端 ----
# OpenAI 兼容服务地址，需包含版本路径，例如：
#   http://localhost:11434/v1   (Ollama)
#   http://localhost:8000/v1    (vLLM)
#   https://ai-gateway.school.edu.cn/v1
VITE_PROXY_TARGET=

# 代理侧注入的密钥（浏览器不可见）
PROXY_API_KEY=
